# Copia este archivo como backend/.env y completa los valores.
# backend/.env está en .gitignore: nunca lo subas al repositorio.

# Puerto del servidor (opcional, 3000 por defecto)
PORT=3000

# Obligatoria. Conexión a PostgreSQL: la usan las migraciones, el seed y la aplicación.
# Formato: postgres://usuario:contraseña@servidor:puerto/base
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/mesa_dragon_db

# Obligatoria. Clave para firmar los tokens de sesión: una cadena larga y aleatoria.
# Se puede generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Duración de la sesión (opcional, 8h por defecto). Ejemplos: 8h, 12h, 1d
JWT_EXPIRATION=8h
